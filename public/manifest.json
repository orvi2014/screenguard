{
  "manifest_version": 3,
  "name": "ScreenGuard – Blur Sensitive Info When Screen Sharing",
  "version": "1.0.17",
  "description": "Blurs emails, card numbers and API keys while you share your screen on Zoom, Meet or Teams, and stops risky links before they open.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScreenGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_permissions": [
    "identity"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
